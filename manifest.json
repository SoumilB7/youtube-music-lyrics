{
  "manifest_version": 3,
  "name": "Lyricly — Synced Lyrics for YouTube Music",
  "short_name": "Lyricly",
  "version": "1.0.0",
  "description": "Large, time-synced lyrics for YouTube Music, with Hindi lyrics automatically romanised into Hinglish.",
  "homepage_url": "https://github.com/SoumilB7/youtube-music-lyrics",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lyricly settings",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/translit.js", "src/lrc.js", "src/ytm.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://lrclib.net/*"]
}
