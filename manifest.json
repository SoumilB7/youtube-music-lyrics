{
  "manifest_version": 3,
  "name": "Lyricly — Synced Lyrics for YouTube Music",
  "short_name": "Lyricly",
  "version": "1.0.0",
  "description": "Large, time-synced lyrics for YouTube Music. Hindi, Punjabi, Tamil, Korean and more shown in English letters.",
  "homepage_url": "https://github.com/SoumilB7/youtube-music-lyrics",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lyricly settings",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/translit.js",
        "src/scripts/bengali.js",
        "src/scripts/gujarati.js",
        "src/scripts/odia.js",
        "src/scripts/tamil.js",
        "src/scripts/telugu.js",
        "src/scripts/kannada.js",
        "src/scripts/malayalam.js",
        "src/scripts/korean.js",
        "src/lrc.js",
        "src/ytm.js",
        "src/store.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lrclib.net/*"
  ]
}
